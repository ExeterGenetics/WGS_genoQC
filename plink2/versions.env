# Pinned source of the modified plink2 used by every pipeline in this repository
# (dnanexus_app/, standalone/, aou_verily/). This is the only place the commit is set;
# build_plink2.sh and the Dockerfiles read it. See README.md in this folder.
PLINK2_REPO=chundruv/plink-ukbb-mod
PLINK2_COMMIT=35073c24bfe9afa91782e36dd89a0c74e34099aa
PLINK2_MAKE_ARGS="SFX= NO_LAPACK=1"
